---

<footer class="mw-footer">
  <div class="fwrap">
    <img class="flogo" src="/wp-content/uploads/2023/04/fix_logo_colour.png" alt="PT Lentera Alam Nusantara — Markas Walet" width="300" height="49" loading="lazy" />
    <div class="fcols">
      <div class="fcol about">
        <h4>Markaswalet.com</h4>
        <p>Markaswalet.com is one of the business units of Lentera Alam Nusantara. Since 2018, the company have engaged in the farming and processing of swiftlet nests.</p>
        <p class="lbl">Office Headquarter and Manufacture :</p>
        <p>Jalan Gubeng Kertajaya 5D No 20, Gubeng Surabaya.</p>
        <p class="lbl">Marketing Office and Gallery :</p>
        <p>Jalan Dharmawangsa 33, Gedung Inkubator Bisnis Universitas Airlangga, Surabaya.</p>
      </div>
      <div class="fcol">
        <h4>Our Product</h4>
        <ul>{products.map((p) => <li><a href={p.href}>{p.label}</a></li>)}</ul>
      </div>
      <div class="fcol">
        <h4>Follow Us</h4>
        <div class="socials">
          {socials.map((s) => (
            <a href={s.href} target="_blank" rel="noopener" aria-label={s.name} title={s.name}>
              <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true"><path d={s.path}></path></svg>
            </a>
          ))}
        </div>
      </div>
      <div class="fcol app">
        <a href="https://play.google.com/store/apps/details?id=com.xomodo.markaswalet" target="_blank" rel="noopener" aria-label="Get Markaswalet on Google Play">
          <img src="/wp-content/uploads/2023/04/google-play.png" alt="Get it on Google Play" width="180" height="70" loading="lazy" />
        </a>
      </div>
    </div>
    <div class="fbottom">© {new Date().getFullYear()} Markas Walet · PT Lentera Alam Nusantara</div>
  </div>

  <style>
    .mw-footer { background: #fff; border-top: 1px solid #e7ebe8; color: #18201c; font-family: 'Poppins', system-ui, sans-serif; }
    .fwrap { max-width: 1180px; margin: 0 auto; padding: 40px 20px 24px; }
    .flogo { height: 48px; width: auto; margin-bottom: 26px; }
    .fcols { display: grid; grid-template-columns: 2fr 1fr 1fr 1fr; gap: 30px; }
    .fcol h4 { margin: 0 0 12px; font-size: 1.05rem; }
    .fcol p { margin: 0 0 10px; color: #5d6b63; font-size: 0.9rem; line-height: 1.6; }
    .fcol p.lbl { color: #18201c; font-weight: 700; margin-top: 14px; }
    .fcol ul { list-style: none; margin: 0; padding: 0; }
    .fcol li { padding: 4px 0; }
    .fcol a { color: #c99400; text-decoration: none; font-size: 0.92rem; }
    .fcol a:hover { color: #a37700; }
    .socials { display: flex; gap: 10px; flex-wrap: wrap; }
    .socials a { width: 38px; height: 38px; display: inline-flex; align-items: center; justify-content: center; border-radius: 50%; background: #f4b41a; color: #1a1300; }
    .socials a:hover { filter: brightness(1.05); }
    .app img { max-width: 180px; height: auto; }
    .fbottom { margin-top: 34px; padding-top: 18px; border-top: 1px solid #eef2ef; color: #7a867f; font-size: 0.82rem; }
    @media (max-width: 820px) { .fcols { grid-template-columns: 1fr 1fr; } .fcol.about { grid-column: 1 / -1; } }
    @media (max-width: 520px) { .fcols { grid-template-columns: 1fr; } }
  </style>
</footer>
